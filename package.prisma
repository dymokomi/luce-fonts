#prisma 4.0
def package "luce-fonts" {
    str owner = "dymokomi"
    str version = "0.3.2"
    str kind = "package"
    str language = "luce-base"
    str description = "Fonts for Luce: native installed families and styles, proportional type set in paragraphs and monospace code faces (CoreText, GDI, cairo), and a portable OpenType engine: sfnt/CFF/WOFF font files, FreeType-exact metrics and outlines, and HarfBuzz-style shaping."
    str readme = "README.md"
    str[] public = ["fonts", "opentype", "shaping"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-std"
    }

    def dependency "luce-compress" {
        str owner = "dymokomi"
        str version = "^0.4.0"
        str path = "../luce-compress"
    }

    def native "macos" {
        str[] frameworks = ["CoreText", "CoreGraphics", "CoreFoundation"]
    }

    def native "windows" {
        str[] libraries = ["gdi32"]
    }
}
