#prisma 4.0
def package "luce-fonts" {
    str owner = "dymokomi"
    str version = "0.2.4"
    str kind = "package"
    str language = "luce-base"
    str description = "Native fonts for Luce: installed families and styles, proportional type set in paragraphs (wrapped, aligned, tracked, led) and monospace code faces. CoreText on macOS, GDI on Windows, cairo on Linux."
    str readme = "README.md"

    def export "fonts" {
        str module = "luce_fonts.fonts"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }

    def native "macos" {
        str[] frameworks = ["CoreText", "CoreGraphics", "CoreFoundation"]
    }

    def native "windows" {
        str[] libraries = ["gdi32"]
    }
}
