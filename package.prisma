#prisma 4.0
def package "luce-fonts" {
    str owner = "dymokomi"
    str version = "0.7.0"
    str kind = "package"
    str language = "luce-base"
    str description = "Fonts for Luce: native installed faces and paragraph type (CoreText, GDI, cairo) and a portable OpenType engine: sfnt/CFF/WOFF/WOFF2 files, FreeType-exact metrics and outlines, HarfBuzz-style shaping."
    str readme = "README.md"
    str[] public = ["fonts", "opentype", "shaping"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str path = "../luce-std"
    }

    def dependency "luce-compress" {
        str owner = "dymokomi"
        str path = "../luce-compress"
    }

    def native "macos" {
        str[] frameworks = ["CoreText", "CoreGraphics", "CoreFoundation"]
    }

    def native "windows" {
        str[] libraries = ["gdi32"]
    }
}
