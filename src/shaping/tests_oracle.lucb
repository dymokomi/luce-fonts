#==============================================================================================
#
#   tests_oracle - shaping against the reference build
#
#   DESCRIPTION:
#       Printed by a local oracle program linked against the reference build's LibGfx
#       (Ladybird 47c82b38d0 with Skia's FreeType backend under the FontConfig font manager,
#       which Ladybird's test mode forces, and HarfBuzz 10.2.0): luce-browser-tools
#       oracles/luce-browser-render/fonts/gen_tests.cpp; regenerate rather than edit.
#       Floats are compared bit for bit through their IEEE bits. The cases are those of
#       the oracle's shaping and WOFF kinds; the bodies (tests_support.lucb) shape through
#       this module and lay the glyphs out as Gfx::shape_text does.
#
#==============================================================================================

test "shape_serenity_sans_44":
    let expected: ShapedGlyph[7] = [
        ShapedGlyph(id = 73, x = 0x40600000, y = 0x40ee8000, width = 0x40ce0000, length = 1),
        ShapedGlyph(id = 82, x = 0x411f0000, y = 0x40ee8000, width = 0x4125c000, length = 1),
        ShapedGlyph(id = 82, x = 0x41a26000, y = 0x40ee8000, width = 0x4125c000, length = 1),
        ShapedGlyph(id = 3, x = 0x41f54000, y = 0x40ee8000, width = 0x41000000, length = 1),
        ShapedGlyph(id = 69, x = 0x421aa000, y = 0x40ee8000, width = 0x41178000, length = 1),
        ShapedGlyph(id = 68, x = 0x42408000, y = 0x40ee8000, width = 0x41158000, length = 1),
        ShapedGlyph(id = 85, x = 0x4265e000, y = 0x40ee8000, width = 0x410d4000, length = 1)]
    test_body_shape("SerenitySans-Regular.ttf", f32.bits(0x41400000), "foo bar", f32.bits(0x00000000), expected[0..<7], 0x427b3000, 0x427b3000)

